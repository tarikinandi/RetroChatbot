# Placeholders only. Real values go in .env (local) or the hosting env (Vercel).
GEMINI_API_KEY=your-api-key-here
# Ordered fallback list (comma-separated). GEMINI_MODEL (single) is still honoured as the first entry.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-flash-latest,gemini-flash-lite-latest

# Public demo build (set automatically by api/index.py on Vercel)
# DEMO_MODE=1
# DAILY_CAP=300
# ALLOWED_ORIGIN=https://portfolio-mtinandi.vercel.app
